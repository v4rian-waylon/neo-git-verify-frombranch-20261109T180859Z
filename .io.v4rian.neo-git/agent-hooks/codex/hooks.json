{
  "PreToolUse": [
    { "matcher": "^Bash$", "command": "codex-adapter.sh bash", "timeout": 10, "statusMessage": "neo-git: checking the command" },
    { "matcher": "^Bash$", "command": "codex-adapter.sh identity", "timeout": 10, "statusMessage": "neo-git: setting the commit identity" },
    { "matcher": "^(apply_patch|Edit|Write)$", "command": "codex-adapter.sh patch", "timeout": 5, "statusMessage": "neo-git: checking the edited paths" }
  ]
}
