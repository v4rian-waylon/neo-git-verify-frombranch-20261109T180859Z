#!/usr/bin/env bash
# prepare-commit-msg - the smart auto-fix layer for commit messages.
#
# Fires after git has assembled the initial commit message (whatever the
# author typed, the merge template, the revert template, etc.) and before
# the editor opens (or in the case of git commit -m, before the commit
# is recorded). This is the right hook for message rewrites because
# editing here is invisible to the author: when the editor opens, they
# already see the cleaned-up version and can accept or refine.
#
# Pipeline:
#
#   1. Skip on merge, squash, and amend message sources, on rebase and
#      cherry-pick replays, and when the operator opted out
#      (NEO_GIT_AUTOFIX=0 or git config neogit.autofix false). [MERGE]
#      subjects get the dash scrub only: the full auto-fix is calibrated
#      for regular commits and would flatten a merge body's list.
#   2. Source the shared auto-fix library.
#   3. Stash a derived [TAG] from the staged diff into the environment
#      so auto_fix_message can prepend it if the title has none.
#   4. Run auto_fix_message on the message file. This rewrites in place.
#   5. Run audit_message; if it returns non-zero, surface the WHAT /
#      WHY / DECIDE block and abort the commit. Otherwise let git
#      continue.
#
# The hook is aggressive on auto-fix and sparing on rejection.

set -uo pipefail

msg_file="$1"
source="${2:-}"
sha="${3:-}"

# Skip on message sources where the auto-fix conventions do not apply.
case "$source" in
  merge|squash|commit)
    exit 0
    ;;
esac

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
LIB="$REPO_ROOT/.io.v4rian.neo-git/scripts/lib/auto-fix-commit-message.sh"

if [ ! -f "$LIB" ] || [ ! -f "$REPO_ROOT/.io.v4rian.neo-git/scripts/_lib.sh" ]; then
  # Library missing: nothing this hook can safely do. Exit clean so
  # users with partial installs are not blocked.
  exit 0
fi

# shellcheck source=../scripts/_lib.sh
. "$REPO_ROOT/.io.v4rian.neo-git/scripts/_lib.sh"

# Never rewrite a replay: rebase and cherry-pick re-commit messages that
# were written (and checked) when the commits were first made.
if hg_replay_in_progress; then
  exit 0
fi

# shellcheck disable=SC1090
. "$LIB"

# Explicit opt-out: NEO_GIT_AUTOFIX=0 for one command, or
# git config neogit.autofix false for a repo or user. The message is kept
# byte for byte; the non-rewriting audit below still runs, and commit-msg
# and pre-push still enforce the message rules.
if ! hg_autofix_enabled; then
  echo ". auto-fix off (NEO_GIT_AUTOFIX or neogit.autofix); message kept verbatim, commit-msg still checks it" >&2
  case "$(head -n1 "$msg_file" 2>/dev/null || true)" in
    "[MERGE] "*) exit 0 ;;
  esac
  audit_message "$msg_file" || exit 1
  exit 0
fi

# [MERGE] subjects get the rule scrub only (hg_scrub_message_file: dashes,
# banned words, Claude trailer; line structure kept). Merge messages (the claim and
# finalize tools, or a hand-composed merge given with -F) carry the
# description paragraph plus nested labelled list shape of the merge body
# rules; the full commit auto-fix is calibrated for regular commits and
# would flatten that list.
subj=$(head -n1 "$msg_file" 2>/dev/null || true)
case "$subj" in
  "[MERGE] "*) hg_scrub_message_file "$msg_file"; exit 0 ;;
esac

# Skip conventional-commit-style messages (chore:, chore(scope):, feat:, fix:,
# refactor:, etc.). Those are typically machine-generated by claim scripts
# (chore(version): bump) or follow a different convention; the v4rian auto-fix
# pipeline is calibrated for [TAG] Title shape and would corrupt the
# conventional form by prepending a [TAG] in front of it.
if [[ "$subj" =~ ^[a-z]+(\([^\)]+\))?:[[:space:]] ]]; then
  exit 0
fi

# Derive a tag from the staged diff shape, then export it so the auto-fix
# python block can pick it up via the environment.
export AUTO_FIX_DERIVED_TAG="$(derive_tag_from_diff)"

auto_fix_message "$msg_file"

# Run the unreconcilable-condition audit. Abort on failure.
if ! audit_message "$msg_file"; then
  exit 1
fi

exit 0
